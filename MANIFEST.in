include LICENSE README.md README.zh-CN.md CONTRIBUTING.md SECURITY.md THIRD_PARTY.md CHANGELOG.md
include requirements-dev.txt RELEASE_NOTES.md
include .gitignore .gitattributes
recursive-include .github *.yml
